# =============================================================================
# Образ Docker для тестирования Puppet-модулей с помощью beaker на Debian 9
# =============================================================================

# Используем официальный базовый образ Debian 9 (Stretch)
FROM debian:9

# -----------------------------------------------------------------------------
# Настройка репозиториев для Debian 9 (который уже EOL - End of Life)
# -----------------------------------------------------------------------------
# Debian 9 (Stretch) достиг конца поддержки, поэтому стандартные репозитории
# deb.debian.org больше не работают. Полностью перезаписываем sources.list
# с правильными ссылками на archive.debian.org с включением contrib и non-free
RUN echo 'deb http://archive.debian.org/debian/ stretch main contrib non-free' > /etc/apt/sources.list && \
    echo 'deb http://archive.debian.org/debian-security/ stretch/updates main contrib non-free' >> /etc/apt/sources.list || true 

# -----------------------------------------------------------------------------
# Копирование конфигурации APT
# -----------------------------------------------------------------------------
# Копируем файл apt.conf, который содержит:
# - Настройки HTTP/HTTPS прокси для доступа к репозиториям через корпоративный шлюз
# - Разрешение использовать небезопасные репозитории (AllowInsecureRepositories)
# - Разрешение даунгрейда до небезопасных репозиториев
# - Отключение проверки срока действия репозитория (Check-Valid-Until)
# - Разрешение установки пакетов без аутентификации (для старых/архивных репозиториев)
COPY test/apt.conf /etc/apt/apt.conf.d/00test_env

# -----------------------------------------------------------------------------
# Установка минимально необходимых пакетов
# -----------------------------------------------------------------------------
# Устанавливаем openssh-server и openssh-client - это минимум для beaker
# curl и libcurl3 будут установлены beaker автоматически во время валидации
RUN apt-get update && apt-get install -y --fix-broken openssh-server openssh-client

# -----------------------------------------------------------------------------
# Настройка SSH доступа для пользователя root
# -----------------------------------------------------------------------------
# Создаём директорию для PID-файла SSH демона
RUN mkdir -p /var/run/sshd
# Устанавливаем пароль root:root (требуется для beaker SSH аутентификации)
RUN echo root:root | chpasswd
# Создаём директорию для SSH ключей и устанавливаем правильные права (700 = rwx------)
RUN mkdir -p /root/.ssh && chmod 700 /root/.ssh

# -----------------------------------------------------------------------------
# Настройка конфигурации SSH демона
# -----------------------------------------------------------------------------
# Настраиваем sshd_config для работы в тестовом окружении beaker:
# - PermitRootLogin yes: разрешаем вход под root (нужно для Puppet тестов)
# - PasswordAuthentication yes: разрешаем аутентификацию по паролю
# - UseDNS no: отключаем DNS resolver (ускоряет подключение)
# - UsePAM no: отключаем PAM (упрощает настройку)
# - MaxAuthTries 1000: увеличиваем лимит попыток аутентификации
RUN sed -ri -e 's/^#?PermitRootLogin .*/PermitRootLogin yes/' \
           -e 's/^#?PasswordAuthentication .*/PasswordAuthentication yes/' \
           -e 's/^#?UseDNS .*/UseDNS no/' \
           -e 's/^#?UsePAM .*/UsePAM no/' \
           -e 's/^#?MaxAuthTries.*/MaxAuthTries 1000/' /etc/ssh/sshd_config \
           $(compgen -G '/etc/ssh/sshd_config.d/*' || echo '')

# -----------------------------------------------------------------------------
# Открытие портов и запуск
# -----------------------------------------------------------------------------
# EXPOSE 22: объявляем, что контейнер слушает порт 22 (SSH)
EXPOSE 22

# CMD: запускаем SSH демон в foreground режиме (-D) для beaker тестов
# Beaker подключается к контейнеру по SSH и выполняет Puppet код
CMD ["/usr/sbin/sshd", "-D"]
